# API Configuration
VITE_API_BASE_URL=	https://api.aeroenix.com/api/v1

# ─── Stripe ──────────────────────────────────────────────────────
VITE_STRIPE_PK=

# ─── PWA ─────────────────────────────────────────────────────────
# Set to 'true' to enable Progressive Web App (service worker + manifest)
VITE_PWA_ENABLED=false

# ─── Reverb (Real-Time WebSocket) ────────────────────────────────
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
